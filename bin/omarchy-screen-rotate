#!/bin/bash
#
# omarchy-screen-rotate [on|off|toggle|status|sync]: turn the laptop's screen and
# its touchpad 90° for reading while walking, and back. With no argument it
# toggles, so running it again undoes it.
#
# On:
#   - the laptop's own panel (eDP, LVDS, DSI) gets Hyprland's transform
#     $TRANSFORM; monitors that mirror it follow;
#   - the touchpad, fixed to the laptop and so turned with it, is turned
#     back by omarchy-screen-rotate-touchpad (libinput cannot rotate a
#     touchpad) in the transient user unit $UNIT;
#   - the bar moves to the left edge (`omarchy bar position left`), the long
#     one once the screen is turned; the edge it was on is kept in
#     $BAR_SAVED and given back when the screen is upright again.
# Mice are left alone: a mouse stays on the table in the user's directions,
# as the turned picture does (until 2 Nov 2026 they were turned too, by
# mistake). Off puts it all back. The screen is set at run time with
# `hyprctl eval`, nothing is written to the Hyprland config: a reload of it (a
# theme change, `hyprctl reload`) puts the screen back by itself, and `sync`
# (which the bar widget runs every 3 seconds) then stops the touchpad too.
#
# status prints one line, "on", "off" or "mixed" (the two disagree), then
# one line each: "screen <transform>", "touchpad active|inactive|failed". sync puts a mixed state back to off and prints the
# state ("busy" while another change runs). Exit 2: no laptop panel found;
# exit 4: the touchpad could not be turned (nothing was).
#
# TRANSFORM and ANGLE go together: transform 3 turns the picture for a laptop
# turned a quarter anticlockwise, and the pad, turned with it, then needs 270°
# clockwise (Stefano's way, 2 Nov 2026). For the other way round: transform 1
# with angle 90.

TRANSFORM=${OMARCHY_SCREEN_ROTATE_TRANSFORM:-3}
ANGLE=${OMARCHY_SCREEN_ROTATE_ANGLE:-270}
UNIT=omarchy-screen-rotate-touchpad
SELF=$(readlink -f "$0")
HELPER=$(dirname "$SELF")/omarchy-screen-rotate-touchpad
BAR_SIDE=${OMARCHY_SCREEN_ROTATE_BAR:-left}
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-screen-rotate
BAR_SAVED=$STATE_DIR/bar-position
SHELL_JSON=${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json

# The laptop's own panel: name, scale and position, or nothing.
panel() {
  hyprctl monitors -j 2>/dev/null |
    jq -r 'first(.[] | select(.name | test("^(eDP|LVDS|DSI)"))) | "\(.name) \(.scale) \(.x)x\(.y) \(.transform)"' 2>/dev/null
}

touchpad_state() {
  systemctl --user is-active "$UNIT" 2>/dev/null || true
}

set_screen() {
  local name scale pos transform
  read -r name scale pos transform <<<"$(panel)"
  [[ -n $name ]] || { echo "omarchy-screen-rotate: no laptop panel found" >&2; return 2; }
  hyprctl eval "hl.monitor({ output = \"$name\", mode = \"preferred\", position = \"$pos\", scale = $scale, transform = $1 })" >/dev/null
}

# The bar's edge before turning is saved once (a second `on` keeps the first
# saved edge) and given back by bar_back, which forgets it; with nothing
# saved the bar is left alone. Kept under ~/.local/state, so a reboot while
# turned still finds it: `sync` then gives the edge back.
bar_aside() {
  if [[ ! -s $BAR_SAVED ]]; then
    mkdir -p "$STATE_DIR"
    jq -r '.bar.position // "top"' "$SHELL_JSON" 2>/dev/null >"$BAR_SAVED" || echo top >"$BAR_SAVED"
  fi
  omarchy bar position "$BAR_SIDE" >/dev/null 2>&1 || true
}

bar_back() {
  [[ -s $BAR_SAVED ]] || return 0
  omarchy bar position "$(cat "$BAR_SAVED")" >/dev/null 2>&1 || true
  rm -f "$BAR_SAVED"
}

# Started, then given a second and a half to take the touchpad: a helper that
# cannot (no udev rule, no touchpad) has exited by then.
touchpad_on() {
  [[ $(touchpad_state) == active ]] && return 0
  systemctl --user reset-failed "$UNIT" 2>/dev/null
  systemd-run --user --quiet --unit="$UNIT" --collect --setenv=PATH="$PATH" \
    -p MemoryMax=200M -p Description="omarchy-screen-rotate: the touchpad turned ${ANGLE}°" \
    "$HELPER" --angle "$ANGLE" || return
  sleep 1.5
  [[ $(touchpad_state) == active ]]
}

touchpad_off() {
  systemctl --user stop "$UNIT" 2>/dev/null
  systemctl --user reset-failed "$UNIT" 2>/dev/null
  return 0
}

# "on", "off" or "mixed".
state() {
  local name scale pos transform
  read -r name scale pos transform <<<"$(panel)"
  local s=off t=off
  [[ $transform != 0 && -n $transform ]] && s=on
  [[ $(touchpad_state) == active ]] && t=on
  if [[ $s == "$t" ]]; then echo "$s"; else echo mixed; fi
}

# The touchpad first: a screen turned with a touchpad that is not would leave
# the laptop hard to control, so if the touchpad fails nothing is turned.
turn_on() {
  [[ -n $(panel) ]] || { echo "omarchy-screen-rotate: no laptop panel found" >&2; return 2; }
  if ! touchpad_on; then
    touchpad_off
    echo "omarchy-screen-rotate: the touchpad could not be turned, so nothing was: journalctl --user -u $UNIT" >&2
    return 4
  fi
  set_screen "$TRANSFORM"
  bar_aside
}

turn_off() {
  touchpad_off
  set_screen 0
  bar_back
}

# One change at a time: a toggle takes the lock and waits for another to end;
# sync, run every few seconds by the bar, skips a round while one is running
# rather than read a half-made state.
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/omarchy-screen-rotate.lock"
if [[ ${1:-toggle} == sync ]]; then
  flock -n 9 || { echo busy; exit 0; }
elif [[ ${1:-toggle} != status ]]; then
  flock 9
fi

case ${1:-toggle} in
  on) turn_on ;;
  off) turn_off ;;
  toggle)
    # Anything turned, even only in part, is put back.
    if [[ $(state) == off ]]; then turn_on; else turn_off; fi ;;
  sync)
    # Whatever is half turned (a Hyprland reload put the screen back, the
    # helper died) is put back whole: upright is the state that always works.
    # The bar's edge comes back too when it is still saved while upright.
    st=$(state)
    if [[ $st == mixed ]]; then turn_off; st=$(state)
    elif [[ $st == off ]]; then bar_back; fi
    echo "$st" ;;
  status)
    read -r _ _ _ transform <<<"$(panel)"
    [[ -n $transform ]] || { echo "omarchy-screen-rotate: no laptop panel found" >&2; exit 2; }
    state
    echo "screen $transform"
    echo "touchpad $(touchpad_state)" ;;
  -h|--help) sed -n '3,32p' "$SELF" | sed 's/^# \{0,1\}//' ;;
  *) echo "usage: omarchy-screen-rotate [on|off|toggle|status|sync]" >&2; exit 64 ;;
esac
